{
  "private": true,
  "name": "nuxtpress",
  "version": "1.4.0",
  "type": "module",
  "scripts": {
    "dev": "bunx nuxi dev --no-restart --public --port 8787",
    "dev:test": "bunx nuxi dev --no-restart --public --port 8787 --dotenv .config/test.env",
    "dev:cloudflare": "bun run build && wrangler dev --local --port 8787",
    "build": "NODE_OPTIONS='--max-old-space-size=4096' nuxt build",
    "postinstall": "nuxt prepare",
    "prettier": "bunx prettier --write .",
    "prettier:check": "bunx prettier --check .",
    "test": "NODE_OPTIONS='--max-old-space-size=4096' bunx playwright test",
    "test:headed": "NODE_OPTIONS='--max-old-space-size=4096' bunx playwright test --headed",
    "test:coverage": "COVERAGE=1 NODE_OPTIONS='--max-old-space-size=4096' bunx playwright test",
    "test:report": "NODE_OPTIONS='--max-old-space-size=4096' bunx playwright show-report",
    "prepare": "husky install",
    "dev:setup-test": "bun scripts/reset-test-data.mjs .data-setup-test && NUXT_PASSWORD= NUXTPRESS_DATA_DIR=.data-setup-test NUXTPRESS_BUILD_DIR=.nuxt-setup-test NUXT_IGNORE_LOCK=1 bunx nuxi dev --no-restart --host 127.0.0.1 --port 8788 --dotenv .config/setup-test.env"
  },
  "peerDependencies": {
    "typescript": "^5.9.3 || ^6.0.0 || ^7.0.0"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@libsql/client": "^0.17.4",
    "@nuxt/icon": "^2.5.1",
    "@nuxt/image": "^2.1.0",
    "@nuxt/kit": "^4.5.2",
    "@nuxt/ui": "^4.11.1",
    "@nuxthub/core": "^0.10.8",
    "@nuxtjs/robots": "^6.2.0",
    "@nuxtjs/sitemap": "^8.5.0",
    "@tiptap/extension-audio": "^3.31.3",
    "@tiptap/extension-emoji": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-youtube": "^3.31.3",
    "@types/luxon": "^3.7.5",
    "@unovis/ts": "^1.6.7",
    "@unovis/vue": "^1.6.7",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "highlight.js": "^11.12.0",
    "luxon": "^3.7.2",
    "marked": "^18.0.12",
    "nuxt": "^4.5.2",
    "nuxt-auth-utils": "^0.5.30",
    "nuxt-schema-org": "^6.3.1",
    "nuxt-viewport": "^2.6.1",
    "xmlbuilder2": "^4.0.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@codecov/nuxt-plugin": "^2.0.1",
    "@iconify-json/cib": "^1.2.3",
    "@iconify-json/lucide": "^1.2.130",
    "@iconify-json/material-symbols": "^1.2.91",
    "@iconify-json/mdi": "^1.2.3",
    "@nuxt/hints": "^1.1.4",
    "@nuxtjs/google-fonts": "^3.2.0",
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.2",
    "husky": "^9.1.7",
    "lightningcss": "^1.33.0",
    "lint-staged": "^17.5.0",
    "monocart-reporter": "^2.13.0",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sass": "^1.104.0",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.129.1"
  },
  "lint-staged": {
    "*.{ts,js,vue,css,scss,md}": "prettier --write"
  }
}
