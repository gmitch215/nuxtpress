{
  "private": true,
  "name": "nuxtpress",
  "version": "1.5.0",
  "type": "module",
  "scripts": {
    "dev": "bunx nuxi dev --no-restart --public --port 8787",
    "dev:test": "bun scripts/reset-test-data.mjs .data-test && NUXTPRESS_DATA_DIR=.data-test bunx nuxi dev --no-restart --public --port 8787 --dotenv .config/test.env",
    "dev:cloudflare": "bun run build && wrangler dev --local --port 8787",
    "build": "NODE_OPTIONS='--max-old-space-size=4096' nuxt build",
    "build:check": "bun run build && bun scripts/check-build-output.mjs",
    "postinstall": "nuxt prepare",
    "prettier": "bunx prettier --write .",
    "prettier:check": "bunx prettier --check .",
    "test": "NODE_OPTIONS='--max-old-space-size=4096' bunx playwright test",
    "test:headed": "NODE_OPTIONS='--max-old-space-size=4096' bunx playwright test --headed",
    "test:coverage": "COVERAGE=1 NODE_OPTIONS='--max-old-space-size=4096' bunx playwright test",
    "coverage:server": "bun scripts/server-coverage.mjs",
    "test:report": "NODE_OPTIONS='--max-old-space-size=4096' bunx playwright show-report",
    "prepare": "husky install",
    "dev:setup-test": "bun scripts/reset-test-data.mjs .data-setup-test && NUXT_PASSWORD= NUXTPRESS_DATA_DIR=.data-setup-test NUXTPRESS_BUILD_DIR=.nuxt-setup-test NUXT_IGNORE_LOCK=1 bunx nuxi dev --no-restart --host 127.0.0.1 --port 8788 --dotenv .config/setup-test.env"
  },
  "overrides": {
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^5.20261014.1",
    "@libsql/client": "^0.17.4",
    "@nuxt/icon": "^2.5.1",
    "@nuxt/image": "^2.1.0",
    "@nuxt/kit": "^4.6.1",
    "@nuxt/ui": "^4.11.3",
    "@nuxthub/core": "^0.10.8",
    "@nuxtjs/robots": "^6.2.4",
    "@nuxtjs/sitemap": "^8.6.2",
    "@tiptap/extension-audio": "^3.32.0",
    "@tiptap/extension-emoji": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-youtube": "^3.32.0",
    "@types/luxon": "^3.7.6",
    "@unovis/ts": "^1.7.1",
    "@unovis/vue": "^1.7.1",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "edgeport": "^1.0.6",
    "highlight.js": "^11.12.0",
    "luxon": "^3.7.2",
    "marked": "^18.1.1",
    "nuxt": "^4.6.1",
    "nuxt-auth-utils": "^0.5.31",
    "nuxt-schema-org": "^7.0.0",
    "nuxt-viewport": "^2.6.1",
    "xmlbuilder2": "^4.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@codecov/nuxt-plugin": "^2.0.1",
    "@iconify-json/cib": "^1.2.3",
    "@iconify-json/lucide": "^1.2.144",
    "@iconify-json/material-symbols": "^1.2.95",
    "@iconify-json/mdi": "^1.2.3",
    "@nuxt/hints": "^1.1.5",
    "@nuxtjs/google-fonts": "^3.2.0",
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.3",
    "husky": "^9.1.7",
    "lightningcss": "^1.33.0",
    "lint-staged": "^17.6.0",
    "monocart-coverage-reports": "^2.13.2",
    "monocart-reporter": "^2.14.1",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sass": "^1.105.1",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.151.0"
  },
  "lint-staged": {
    "*.{ts,js,vue,css,scss,md}": "prettier --write"
  }
}
